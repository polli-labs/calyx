{
  "name": "@polli-labs/calyx-run-service",
  "version": "0.2.0",
  "description": "Run orchestration, persistence, and reconciliation layer for Calyx.",
  "repository": {
    "type": "git",
    "url": "https://github.com/polli-labs/calyx",
    "directory": "packages/run-service"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --target node22 --tsconfig tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.215.0",
    "@opentelemetry/resources": "^2.7.0",
    "@opentelemetry/sdk-metrics": "^2.7.0",
    "@opentelemetry/semantic-conventions": "^1.40.0",
    "@polli-labs/calyx-core": "workspace:*",
    "@polli-labs/calyx-runner": "workspace:*",
    "yaml": "^2.9.0",
    "zod": "^3.24.2"
  }
}
