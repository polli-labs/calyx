{
  "name": "calyx-ext-linear",
  "version": "0.2.0",
  "description": "First-party advisory Linear extension for Calyx \u2014 issue context hints and exec diagnostics.",
  "repository": {
    "type": "git",
    "url": "https://github.com/polli-labs/calyx",
    "directory": "packages/calyx-ext-linear"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./runtime": {
      "import": "./dist/runtime/index.js",
      "types": "./dist/runtime/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "calyx": {
    "apiVersion": "1",
    "domains": [
      "agents",
      "exec"
    ]
  },
  "scripts": {
    "build": "tsup src/index.ts src/runtime/index.ts --format esm --dts --target node22 --tsconfig tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@polli-labs/calyx-run-service": "workspace:*"
  },
  "peerDependencies": {
    "@polli-labs/calyx-sdk": ">=0.1.0"
  },
  "devDependencies": {
    "@polli-labs/calyx-core": "workspace:*",
    "@polli-labs/calyx-sdk": "workspace:*"
  }
}
