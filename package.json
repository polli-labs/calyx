{
  "name": "calyx-dev",
  "private": true,
  "version": "0.2.0",
  "description": "Private development monorepo for the Calyx agent control plane.",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@10.34.1",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build && node scripts/stamp-build-info.mjs",
    "lint": "eslint .",
    "typecheck": "pnpm -r --filter './packages/*' typecheck",
    "test": "vitest run",
    "spec:generate": "node scripts/generate-openapi.mjs",
    "client:generate": "node scripts/generate-client.mjs",
    "client:omission-policy": "node scripts/check-client-omissions.mjs --as-of=current",
    "client:package-check": "node scripts/check-client-package.mjs",
    "contract:generate": "pnpm spec:generate && pnpm client:generate",
    "contract:check": "pnpm contract:generate && pnpm client:omission-policy && git diff --exit-code -- calyx-openapi.json packages/client/src/generated",
    "spec:check": "pnpm contract:check",
    "verify": "node scripts/verify.mjs",
    "verify:cold": "node scripts/verify.mjs --cold"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@types/node": "^22.13.9",
    "ajv": "^8.20.0",
    "eslint": "^9.21.0",
    "openapi-typescript": "7.13.0",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.25.0",
    "vitest": "^3.2.6"
  }
}
